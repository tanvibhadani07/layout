# Copy this file to ".env.local" (same folder) and fill in your real
# MongoDB Atlas connection string. ".env.local" is already git-ignored
# by Next.js's default .gitignore, so your credentials won't be committed.

# Format:
# mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database_name>?retryWrites=true&w=majority
# mongodb+srv://tanvi_usermongodb:Oog7j9jaoTCGvRPB>@cluster0.prazz6x.mongodb.net/?user=Cluster0&compressors=zlib


# MONGODB_URI="mongodb+srv://tanvi_usermongodb:bilRd2OiIvvJLrOG@cluster0.prazz6x.mongodb.net/layout?retryWrites=true&w=majority"

MONGODB_URI="mongodb+srv://tanvi_usermongodb:bilRd2OiIvvJLrOG@cluster0.prazz6x.mongodb.net/layout?retryWrites=true&w=majority"